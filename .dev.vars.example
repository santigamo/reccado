# Local-only example values. Do not commit real secrets in `.dev.vars`.
#
# You normally do NOT need to copy this: `pnpm dev` auto-generates a minimal
# `.dev.vars` via scripts/ensure-dev-vars.ts if one is missing. This file is the
# reference for every supported variable AND the canonical basis for `wrangler types`
# (`pnpm cf-typegen`) — so every key must stay present here even when its value is empty,
# or the generated worker-configuration.d.ts would drop it.
#
# The Access / API-token values are intentionally LEFT EMPTY (not placeholder strings):
# the local-dev bypass in src/lib/runtime-config.ts stays active only while BOTH Access
# vars are empty/absent, so copying this file verbatim keeps local `/api/*` working.
# Fill them in only when you deliberately test the real Access perimeter or admin
# provisioning locally.

# Key order below is significant: `wrangler types` emits keys in this order, so it must match
# the committed worker-configuration.d.ts (the CI "generated artifacts" check diffs it).

# Unlocks the local /api/debug/phase0/* introspection endpoints the smoke scripts use.
PHASE0_DEBUG_TOKEN=dev-phase0-debug-token

# Which Cloudflare jurisdiction mailbox Durable Objects are pinned to. Deployed
# environments declare "eu" in wrangler.jsonc; locally this must be "none",
# because workerd does not implement jurisdictions and `jurisdiction()` throws.
# Only "eu" and "none" are accepted — an unset value is a loud error rather than
# a silent fall back to an unpinned Durable Object.
MAILBOX_JURISDICTION=none

# Cloudflare API token for admin provisioning workflows (leave empty for local dev).
# Minimum intended scope: zone read, email routing write for test zones, and Access app/policy write only when configuring Access by API.
CLOUDFLARE_API_TOKEN=

# Cloudflare Access validation settings (leave empty for local dev; see note above).
ACCESS_JWT_AUDIENCE=
ACCESS_TEAM_DOMAIN=

# --- Telegram bridge (optional) --------------------------------------------
# Deliberately NOT active keys in this file: they are deployed with
# `wrangler secret put` / `[vars]`, and adding them here would change the
# generated worker-configuration.d.ts that CI diffs. They are declared as
# optional in src/env.d.ts. Leave the bot token unset to keep the bridge off.
#
#   TELEGRAM_BOT_TOKEN         from @BotFather; unset = bridge disabled
#   TELEGRAM_ALLOWED_USER_IDS  comma-separated Telegram user ids. NOT required any more:
#                              an emergency bootstrap for a deployment you cannot pair.
#
# Who may drive the bot is a trust declaration and stays human — but it is made by
# pairing now, not by committing a user id. While no operator is linked, the hourly cron
# keeps exactly one single-use code alive in D1, and you read it the way you read
# anything else in D1:
#
#   wrangler d1 execute inbox-mcp-index-dev --remote --env dev --command \
#     "SELECT code, expires_at FROM owner_pairing_codes WHERE consumed_at IS NULL \
#      AND expires_at > strftime('%Y-%m-%dT%H:%M:%fZ','now') ORDER BY created_at DESC LIMIT 1"
#
# Send `/start <code>` to the bot from the account you want to authorise. The code is
# spent on first use, the account lands in owner_identities, and the link is written to
# ops_events. This is the bootstrap path on purpose: the authenticated UI needs a
# Cloudflare Access JWT, and on a hostname with no Access app in front of it nobody can
# obtain one — so the pairing code must be reachable through `wrangler`, not only
# through a screen you cannot open. To mint one by hand instead (or to add a second
# operator, which the cron deliberately will not do once one exists):
#
#   INSERT INTO owner_pairing_codes (code, created_at, expires_at, issued_by)
#   VALUES ('<code you generated>', strftime('%Y-%m-%dT%H:%M:%fZ','now'),
#           strftime('%Y-%m-%dT%H:%M:%fZ','now','+2 hours'), 'manual')
#
# The same table names the web side of the same owner: `owner_identities` rows of kind
# 'email' are what ACCESS_ALLOWED_EMAILS used to be, and both are read together:
#
#   INSERT INTO owner_identities (kind, identity, linked_at, linked_via)
#   VALUES ('email', 'you@example.com', strftime('%Y-%m-%dT%H:%M:%fZ','now'), 'manual')
#
# Order matters on a deployment whose UI you cannot open. The cron only registers the
# Telegram webhook once the worker has observed its own public origin, and it observes that
# from an authenticated request -- so either register the email owner above and load the UI
# once, or write the origin down yourself:
#
#   INSERT INTO runtime_config (key, value, updated_at)
#   VALUES ('deployment.origin', 'https://your-host', strftime('%Y-%m-%dT%H:%M:%fZ','now'))
#   ON CONFLICT(key) DO UPDATE SET value = excluded.value
#
# There is deliberately no TELEGRAM_WEBHOOK_SECRET (derived from the bot token), no
# TELEGRAM_CHAT_ID (adopted on the first /start) and no TELEGRAM_TOPICS (whether the
# chat is a forum is read from getChat on /start; if it is, each mailbox gets its own
# topic). None was ever a decision a human could make better than the machine, and all
# were steps people forgot.
#
# --- Outbound sender identity (optional) ------------------------------------
#   MAIL_SENDING_DOMAINS       comma-separated domains verified in Cloudflare Email Sending;
#                              a mailbox on one of them sends as itself, otherwise the reply
#                              goes out as MAIL_FROM_ADDRESS with Reply-To set
#
# --- Transactional API key pepper (optional) -------------------------------
# The HMAC-SHA256 pepper used to hash transactional API keys. Must be a long,
# random, secret string. Without it, API key operations fail closed.
# Set via `wrangler secret put TRANSACTIONAL_API_KEY_PEPPER` in production;
# leave empty here for local development unless testing key operations.
TRANSACTIONAL_API_KEY_PEPPER=
